{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MomentumStudio AI",
  "version": "0.2.0",
  "identifier": "ai.momentumstudio.desktop",
  "build": {
    "frontendDist": "../src/client"
  },
  "app": {
    "windows": [
      {
        "title": "MomentumStudio AI",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8018 blob:; img-src 'self' data: blob:; worker-src 'self' blob:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
